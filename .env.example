# Copy to .env.local and fill in. Never commit real values.

# @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Bot username without @, e.g. meetslot_bot
TELEGRAM_BOT_USERNAME=
# @BotFather → /newapp → short name, e.g. meet  (link: t.me/<bot>/<short_name>)
TELEGRAM_MINI_APP_SHORT_NAME=
# Any random string, 16+ chars (openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=

# Public URL of the deployed app, e.g. https://meet-tg-app.vercel.app
APP_URL=

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
