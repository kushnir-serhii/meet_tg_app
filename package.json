{
  "name": "meet-tg-app",
  "version": "0.1.0",
  "private": true,
  "allowScripts": {
    "esbuild": true,
    "unrs-resolver": true
  },
  "type": "module",
  "scripts": {
    "dev": "next dev ",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "webhook:set": "tsx --env-file=.env.local scripts/set-webhook.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "refund": "tsx --env-file=.env.local scripts/refund.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "grammy": "^1.46.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4"
  }
}
